// pdf_util.baga — текстови/таблични помощници, изнесени от pdf.baga
// (filesize gate 600): hex, измерване, wrap, ширини на колони, cmap.

import "std/str/str.baga"
import "std/os/os.baga"
import "bufbaga/buf.baga"
import "utf8.baga"
import "ttf.baga"

fn pdf_hex_digit(v: i64) -> i64 {
    let x = v & 15
    if x < 10 {
        return 48 + x
    }
    return 55 + x
}

fn pdf_hex_byte(v: i64) -> str {
    let mut b = buf_new()
    b = buf_push_chr(b, pdf_hex_digit(v / 16))
    b = buf_push_chr(b, pdf_hex_digit(v))
    return buf_str(b)
}

// UTF-8 → PDF hex of BE glyph IDs (CIDToGIDMap /Identity)
fn pdf_text_hex(font: TtfFont, s: str) -> str {
    let mut b = buf_new()
    b = buf_push(b, "<")
    let mut i: i64 = 0
    while i < len(s) {
        let u = utf8_next(s, i)
        if u.ok == 0 {
            break
        }
        let mut g = ttf_glyph(font, u.cp)
        if g == 0 && u.cp != 0 {
            g = ttf_glyph(font, 63)
        }
        b = buf_push(b, pdf_hex_byte((g / 256) & 255))
        b = buf_push(b, pdf_hex_byte(g & 255))
        i = u.next
    }
    b = buf_push(b, ">")
    return buf_str(b)
}

fn pdf_pad10(off: i64) -> str {
    let s = int_to_str(off)
    let mut b = buf_new()
    let mut n = 10 - len(s)
    if n < 0 {
        n = 0
    }
    let mut i: i64 = 0
    while i < n {
        b = buf_push_chr(b, 48)
        i = i + 1
    }
    b = buf_push(b, s)
    return buf_str(b)
}

fn pdf_ulen(s: str) -> i64 {
    let mut n: i64 = 0
    let mut i: i64 = 0
    while i < len(s) {
        let u = utf8_next(s, i)
        if u.ok == 0 {
            break
        }
        n = n + 1
        i = u.next
    }
    return n
}

fn pdf_uclip(s: str, maxn: i64) -> str {
    if maxn < 2 {
        return s
    }
    if pdf_ulen(s) <= maxn {
        return s
    }
    let keep = maxn - 1
    let mut i: i64 = 0
    let mut n: i64 = 0
    while i < len(s) && n < keep {
        let u = utf8_next(s, i)
        if u.ok == 0 {
            break
        }
        n = n + 1
        i = u.next
    }
    return concat(substr(s, 0, i), "..")
}

fn pdf_char_w(font: TtfFont, cp: i64, fs: i64) -> i64 {
    let g = ttf_glyph(font, cp)
    let adv = ttf_advance_pdf(font, g)
    let w = adv * fs / 1000
    if w < 1 {
        return 1
    }
    return w
}

fn pdf_str_w(font: TtfFont, s: str, fs: i64) -> i64 {
    let mut w: i64 = 0
    let mut i: i64 = 0
    while i < len(s) {
        let u = utf8_next(s, i)
        if u.ok == 0 {
            break
        }
        w = w + pdf_char_w(font, u.cp, fs)
        i = u.next
    }
    return w
}

fn pdf_fit_len(font: TtfFont, s: str, fs: i64, maxw: i64) -> i64 {
    let mut w: i64 = 0
    let mut i: i64 = 0
    let mut last: i64 = 0
    while i < len(s) {
        let u = utf8_next(s, i)
        if u.ok == 0 {
            break
        }
        let cw = pdf_char_w(font, u.cp, fs)
        if last > 0 && w + cw > maxw {
            return last
        }
        w = w + cw
        last = u.next
        i = u.next
    }
    return last
}

fn pdf_wrap_to_width(font: TtfFont, s: str, fs: i64, maxw: i64) -> Vec<str> {
    let out: Vec<str> = vec_new()
    let mut limit = maxw
    if limit < 12 {
        limit = 12
    }
    if s == "" {
        vec_push(out, "")
        return out
    }
    let words = str_split(s, " ")
    let mut cur = ""
    let mut i: i64 = 0
    while i < vec_len(words) {
        let w = vec_get(words, i)
        if w == "" {
            i = i + 1
        } else {
            if cur == "" {
                if pdf_str_w(font, w, fs) <= limit {
                    cur = w
                    i = i + 1
                } else {
                    let mut rest = w
                    while pdf_str_w(font, rest, fs) > limit && len(rest) > 1 {
                        let mut n = pdf_fit_len(font, rest, fs, limit)
                        if n < 1 {
                            n = 1
                        }
                        vec_push(out, substr(rest, 0, n))
                        rest = substr(rest, n, len(rest))
                    }
                    cur = rest
                    i = i + 1
                }
            } else {
                let trial = concat(cur, concat(" ", w))
                if pdf_str_w(font, trial, fs) <= limit {
                    cur = trial
                    i = i + 1
                } else {
                    vec_push(out, cur)
                    cur = ""
                }
            }
        }
    }
    if cur != "" {
        vec_push(out, cur)
    }
    if vec_len(out) < 1 {
        vec_push(out, s)
    }
    return out
}

fn pdf_w_array(font: TtfFont) -> str {
    let n = vec_len(font.advances)
    if n < 1 {
        return ""
    }
    let mut b = buf_from(" /W [ 0 [")
    let mut i: i64 = 0
    while i < n {
        b = buf_push(b, " ")
        b = buf_push_i64(b, ttf_advance_pdf(font, i))
        i = i + 1
    }
    b = buf_push(b, " ] ]")
    return buf_str(b)
}

fn pdf_rect(cbuf: StrBuf, x: i64, y: i64, w: i64, h: i64, fill: i64) -> StrBuf {
    let mut b = cbuf
    if fill == 1 {
        b = buf_push(b, "0.92 g ")
        b = buf_push_i64(b, x)
        b = buf_push(b, " ")
        b = buf_push_i64(b, y)
        b = buf_push(b, " ")
        b = buf_push_i64(b, w)
        b = buf_push(b, " ")
        b = buf_push_i64(b, h)
        b = buf_push(b, " re f 0 g\n")
    }
    b = buf_push(b, "0.4 w ")
    b = buf_push_i64(b, x)
    b = buf_push(b, " ")
    b = buf_push_i64(b, y)
    b = buf_push(b, " ")
    b = buf_push_i64(b, w)
    b = buf_push(b, " ")
    b = buf_push_i64(b, h)
    b = buf_push(b, " re S\n")
    return b
}

fn pdf_looks_num(s: str) -> i64 {
    let t = str_trim(s)
    if t == "" {
        return 0
    }
    let mut i: i64 = 0
    let mut digits: i64 = 0
    if char_at(t, 0) == 45 {
        i = 1
    }
    while i < len(t) {
        let c = char_at(t, i)
        if c >= 48 && c <= 57 {
            digits = digits + 1
        } else {
            if c != 46 && c != 44 && c != 32 {
                return 0
            }
        }
        i = i + 1
    }
    if digits > 0 {
        return 1
    }
    return 0
}

fn pdf_col_weights(rows: Vec<str>, ncols: i64) -> Vec<i64> {
    let w: Vec<i64> = vec_new()
    let mut c: i64 = 0
    while c < ncols {
        vec_push(w, 2)
        c = c + 1
    }
    let mut r: i64 = 0
    while r < vec_len(rows) {
        let cells = str_split(vec_get(rows, r), "\t")
        c = 0
        while c < ncols {
            let mut cell = ""
            if c < vec_len(cells) {
                cell = vec_get(cells, c)
            }
            let n = pdf_ulen(cell)
            if n > vec_get(w, c) {
                vec_set(w, c, n)
            }
            c = c + 1
        }
        r = r + 1
    }
    c = 0
    while c < ncols {
        let n = vec_get(w, c)
        if n > 40 {
            vec_set(w, c, 40)
        }
        c = c + 1
    }
    return w
}

fn pdf_table_widths(font: TtfFont, rows: Vec<str>, ncols: i64, usable: i64, fs: i64) -> Vec<i64> {
    let out: Vec<i64> = vec_new()
    if ncols == 2 {
        let half = usable / 2
        vec_push(out, half)
        vec_push(out, usable - half)
        return out
    }
    let mut mins: Vec<i64> = vec_new()
    let mut c: i64 = 0
    while c < ncols {
        vec_push(mins, 18)
        c = c + 1
    }
    let mut r: i64 = 0
    while r < vec_len(rows) {
        let cells = str_split(vec_get(rows, r), "\t")
        c = 0
        while c < ncols {
            let mut cell = ""
            if c < vec_len(cells) {
                cell = vec_get(cells, c)
            }
            let mut need: i64 = 18
            if r == 0 || pdf_looks_num(cell) == 1 {
                need = pdf_str_w(font, cell, fs) + 12
            } else {
                need = 40
            }
            if need > vec_get(mins, c) {
                vec_set(mins, c, need)
            }
            c = c + 1
        }
        r = r + 1
    }
    let mut sum: i64 = 0
    c = 0
    while c < ncols {
        sum = sum + vec_get(mins, c)
        c = c + 1
    }
    let mut grow: i64 = 0
    if ncols >= 6 {
        grow = 1
    }
    if sum > usable && sum > 0 {
        c = 0
        while c < ncols {
            vec_set(mins, c, vec_get(mins, c) * usable / sum)
            if vec_get(mins, c) < 16 {
                vec_set(mins, c, 16)
            }
            c = c + 1
        }
        sum = 0
        c = 0
        while c < ncols {
            sum = sum + vec_get(mins, c)
            c = c + 1
        }
    }
    if sum < usable {
        vec_set(mins, grow, vec_get(mins, grow) + (usable - sum))
    } else {
        if sum > usable {
            let mut g = vec_get(mins, grow) - (sum - usable)
            if g < 16 {
                g = 16
            }
            vec_set(mins, grow, g)
        }
    }
    return mins
}

fn pdf_spread_cols(weights: Vec<i64>, usable: i64) -> Vec<i64> {
    let n = vec_len(weights)
    let mut minw: i64 = 20
    if n > 8 {
        minw = 16
    }
    let mut sumw: i64 = 0
    let mut i: i64 = 0
    while i < n {
        sumw = sumw + vec_get(weights, i)
        i = i + 1
    }
    if sumw < 1 {
        sumw = n
    }
    let out: Vec<i64> = vec_new()
    let mut used: i64 = 0
    i = 0
    while i < n {
        let mut w = usable * vec_get(weights, i) / sumw
        if w < minw {
            w = minw
        }
        vec_push(out, w)
        used = used + w
        i = i + 1
    }
    if used > usable && used > 0 {
        i = 0
        while i < n {
            vec_set(out, i, vec_get(out, i) * usable / used)
            i = i + 1
        }
    } else {
        let extra = usable - used
        if extra > 0 {
            let mut grow = 0
            if n > 1 {
                grow = 1
            }
            vec_set(out, grow, vec_get(out, grow) + extra)
        }
    }
    return out
}

fn pdf_meta_wrap(meta: str, maxc: i64) -> Vec<str> {
    let out: Vec<str> = vec_new()
    if meta == "" {
        return out
    }
    let parts = str_split(meta, " · ")
    let mut cur = ""
    let mut i: i64 = 0
    while i < vec_len(parts) {
        let p = str_trim(vec_get(parts, i))
        if cur == "" {
            cur = p
        } else {
            let trial = concat(cur, concat(" · ", p))
            if pdf_ulen(trial) > maxc {
                vec_push(out, cur)
                cur = p
            } else {
                cur = trial
            }
        }
        i = i + 1
    }
    if cur != "" {
        vec_push(out, cur)
    }
    return out
}
fn pdf_hex4(v: i64) -> str {
    let x = v & 65535
    return concat(pdf_hex_byte((x / 256) & 255), pdf_hex_byte(x & 255))
}

fn pdf_cps_has(cps: Vec<i64>, cp: i64) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(cps) {
        if vec_get(cps, i) == cp {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn pdf_touni_cmap_str(font: TtfFont, srcs: Vec<str>) -> str {
    let cps: Vec<i64> = vec_new()
    let mut si: i64 = 0
    while si < vec_len(srcs) {
        let s = vec_get(srcs, si)
        let mut i: i64 = 0
        while i < len(s) {
            let u = utf8_next(s, i)
            if u.ok == 0 {
                break
            }
            if u.cp > 0 {
                if pdf_cps_has(cps, u.cp) == 0 {
                    vec_push(cps, u.cp)
                }
            }
            i = u.next
        }
        si = si + 1
    }
    let mut b = buf_from("/CIDInit /ProcSet findresource begin\n12 dict begin\nbegincmap\n/CIDSystemInfo << /Registry (Adobe) /Ordering (UCS) /Supplement 0 >> def\n/CMapName /Adobe-Identity-UCS def\n/CMapType 2 def\n1 begincodespacerange\n<0000> <FFFF>\nendcodespacerange\n")
    let n = vec_len(cps)
    let mut off: i64 = 0
    while off < n {
        let mut chunk = n - off
        if chunk > 100 {
            chunk = 100
        }
        b = buf_push_i64(b, chunk)
        b = buf_push(b, " beginbfchar\n")
        let mut j: i64 = 0
        while j < chunk {
            let cp = vec_get(cps, off + j)
            let g = ttf_glyph(font, cp)
            b = buf_push(b, "<")
            b = buf_push(b, pdf_hex4(g))
            b = buf_push(b, "> <")
            b = buf_push(b, pdf_hex4(cp))
            b = buf_push(b, ">\n")
            j = j + 1
        }
        b = buf_push(b, "endbfchar\n")
        off = off + chunk
    }
    b = buf_push(b, "endcmap\nCMapName currentdict /CMap defineresource pop\nend\nend\n")
    return buf_str(b)
}

