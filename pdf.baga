// pdf.baga — pure PDF writer with UTF-8 via embedded TrueType (Identity-H).
// Accounting tables: title + multi-page grid.

import "std/str/str.baga"
import "std/os/os.baga"
import "bufbaga/buf.baga"
import "utf8.baga"
import "pdf_util.baga"
import "ttf.baga"

struct PdfResult {
    ok: i64,
    err: str,
    data: bytes
}

fn pdf_fail(msg: str) -> PdfResult {
    return PdfResult { ok: 0, err: msg, data: bytes_new(0) }
}

fn pdf_ok(data: bytes) -> PdfResult {
    return PdfResult { ok: 1, err: "", data: data }
}

fn pdf_version() -> str {
    return "0.2.2"
}


fn pdf_from_table(font: TtfFont, title: str, rows: Vec<str>) -> PdfResult {
    return pdf_from_table_full(font, title, "", rows, 0)
}

fn pdf_from_table_fs(font: TtfFont, title: str, rows: Vec<str>, font_size: i64) -> PdfResult {
    return pdf_from_table_full(font, title, "", rows, font_size)
}

fn pdf_from_table_full(font: TtfFont, title: str, meta: str, rows: Vec<str>, font_size: i64) -> PdfResult {
    if font.ok == 0 {
        return pdf_fail(font.err)
    }
    if vec_len(rows) == 0 {
        return pdf_fail("pdf: no rows")
    }

    let page_w: i64 = 595
    let page_h: i64 = 842
    let margin: i64 = 36
    let header = vec_get(rows, 0)
    let hcells: Vec<str> = str_split(header, "\t")
    let ncols = vec_len(hcells)
    if ncols < 1 {
        return pdf_fail("pdf: empty header")
    }
    let mut fs = font_size
    if fs == 0 {
        fs = 9
        if ncols >= 6 {
            fs = 8
        }
        if ncols >= 8 {
            fs = 7
        }
    }
    if fs < 7 { fs = 7 }
    if fs > 12 { fs = 12 }
    let line_h = fs + 5
    let usable_w = page_w - 2 * margin
    let widths = pdf_spread_cols(pdf_col_weights(rows, ncols), usable_w)
    let xs: Vec<i64> = vec_new()
    let mut acc = margin
    let mut ci: i64 = 0
    while ci < ncols {
        vec_push(xs, acc)
        acc = acc + vec_get(widths, ci)
        ci = ci + 1
    }
    let top0 = page_h - margin
    let mlines = pdf_meta_wrap(meta, 92)
    let head_lines = 1 + vec_len(mlines)
    let body_rows_fit = (top0 - margin - (head_lines + 2) * line_h) / line_h
    if body_rows_fit < 2 {
        return pdf_fail("pdf: layout")
    }

    let page_streams: Vec<str> = vec_new()
    let mut r: i64 = 0
    let nrows = vec_len(rows)
    while r < nrows {
        let mut cbuf = buf_new()
        let mut y = top0
        let ttl = pdf_uclip(title, 80)
        cbuf = buf_push(cbuf, "BT /F1 ")
        cbuf = buf_push(cbuf, int_to_str(fs + 3))
        cbuf = buf_push(cbuf, " Tf 1 0 0 1 ")
        cbuf = buf_push(cbuf, int_to_str(margin))
        cbuf = buf_push(cbuf, " ")
        cbuf = buf_push(cbuf, int_to_str(y))
        cbuf = buf_push(cbuf, " Tm ")
        cbuf = buf_push(cbuf, pdf_text_hex(font, ttl))
        cbuf = buf_push(cbuf, " Tj ET\n")
        y = y - (line_h + 2)
        let mut mi: i64 = 0
        while mi < vec_len(mlines) {
            cbuf = buf_push(cbuf, "BT /F1 ")
            cbuf = buf_push(cbuf, int_to_str(fs))
            cbuf = buf_push(cbuf, " Tf 1 0 0 1 ")
            cbuf = buf_push(cbuf, int_to_str(margin))
            cbuf = buf_push(cbuf, " ")
            cbuf = buf_push(cbuf, int_to_str(y))
            cbuf = buf_push(cbuf, " Tm ")
            cbuf = buf_push(cbuf, pdf_text_hex(font, vec_get(mlines, mi)))
            cbuf = buf_push(cbuf, " Tj ET\n")
            y = y - line_h
            mi = mi + 1
        }
        y = y - 4

        let mut used: i64 = 0
        while r < nrows && used < body_rows_fit {
            let line = vec_get(rows, r)
            let cells: Vec<str> = str_split(line, "\t")
            let row_bot = y - line_h
            let mut fill: i64 = 0
            if r == 0 {
                fill = 1
            }
            let mut c: i64 = 0
            while c < ncols {
                cbuf = pdf_rect(cbuf, vec_get(xs, c), row_bot, vec_get(widths, c), line_h, fill)
                c = c + 1
            }
            c = 0
            while c < ncols {
                let mut cell = ""
                if c < vec_len(cells) {
                    cell = vec_get(cells, c)
                }
                let cw = vec_get(widths, c)
                let mut inner = cw - 6
                if inner < 8 {
                    inner = 8
                }
                let mut show = cell
                if pdf_str_w(font, show, fs) > inner {
                    let n = pdf_fit_len(font, show, fs, inner)
                    if n > 1 {
                        show = concat(substr(show, 0, n), "..")
                    }
                }
                let mut x = vec_get(xs, c) + 3
                if r > 0 && pdf_looks_num(cell) == 1 {
                    let tw = pdf_str_w(font, show, fs)
                    let rx = vec_get(xs, c) + cw - 3 - tw
                    if rx > x {
                        x = rx
                    }
                }
                cbuf = pdf_draw_line(cbuf, font, fs, x, y - fs - 2, show)
                c = c + 1
            }
            y = row_bot
            r = r + 1
            used = used + 1
        }
        vec_push(page_streams, buf_str(cbuf))
    }

    return pdf_pack_pages_uni(font, page_streams, rows)
}

fn pdf_pack_pages(font: TtfFont, page_streams: Vec<str>) -> PdfResult {
    let empty: Vec<str> = vec_new()
    return pdf_pack_pages_uni(font, page_streams, empty)
}

fn pdf_pack_pages_uni(font: TtfFont, page_streams: Vec<str>, uni_src: Vec<str>) -> PdfResult {
    if vec_len(page_streams) < 1 {
        return pdf_fail("pdf: empty")
    }
    let np = vec_len(page_streams)
    let o_page0 = 3
    let o_cont0 = 3 + np
    let o_font0 = 3 + 2 * np
    let o_cid = o_font0 + 1
    let o_desc = o_font0 + 2
    let o_ffile = o_font0 + 3
    let o_touni = o_font0 + 4

    let mut pdfb = bytes_of_str("%PDF-1.4\n")
    // binary comment for PDF
    let mag = bytes_new(5)
    bytes_set(mag, 0, 37)
    bytes_set(mag, 1, 226)
    bytes_set(mag, 2, 227)
    bytes_set(mag, 3, 207)
    bytes_set(mag, 4, 211)
    pdfb = bytes_concat(pdfb, mag)
    pdfb = bytes_concat(pdfb, bytes_of_str("\n"))

    let offs: Vec<i64> = vec_new()
    vec_push(offs, 0)

    vec_push(offs, bytes_len(pdfb))
    pdfb = bytes_concat(pdfb, bytes_of_str("1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n"))

    vec_push(offs, bytes_len(pdfb))
    let mut kids = buf_from("[ ")
    let mut i: i64 = 0
    while i < np {
        kids = buf_push_i64(kids, o_page0 + i)
        kids = buf_push(kids, " 0 R ")
        i = i + 1
    }
    kids = buf_push(kids, "]")
    let mut p2 = buf_from("2 0 obj\n<< /Type /Pages /Kids ")
    p2 = buf_push(p2, buf_str(kids))
    p2 = buf_push(p2, " /Count ")
    p2 = buf_push_i64(p2, np)
    p2 = buf_push(p2, " >>\nendobj\n")
    pdfb = bytes_concat(pdfb, bytes_of_str(buf_str(p2)))

    i = 0
    while i < np {
        vec_push(offs, bytes_len(pdfb))
        let pobj = o_page0 + i
        let cobj = o_cont0 + i
        let mut po = buf_new()
        po = buf_push_i64(po, pobj)
        po = buf_push(po, " 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Contents ")
        po = buf_push_i64(po, cobj)
        po = buf_push(po, " 0 R /Resources << /Font << /F1 ")
        po = buf_push_i64(po, o_font0)
        po = buf_push(po, " 0 R >> >> >>\nendobj\n")
        pdfb = bytes_concat(pdfb, bytes_of_str(buf_str(po)))
        i = i + 1
    }

    i = 0
    while i < np {
        vec_push(offs, bytes_len(pdfb))
        let stream = vec_get(page_streams, i)
        let cobj = o_cont0 + i
        let mut co = buf_new()
        co = buf_push_i64(co, cobj)
        co = buf_push(co, " 0 obj\n<< /Length ")
        co = buf_push_i64(co, len(stream))
        co = buf_push(co, " >>\nstream\n")
        co = buf_push(co, stream)
        co = buf_push(co, "\nendstream\nendobj\n")
        pdfb = bytes_concat(pdfb, bytes_of_str(buf_str(co)))
        i = i + 1
    }

    vec_push(offs, bytes_len(pdfb))
    pdfb = bytes_concat(pdfb, bytes_of_str(concat(concat(concat(int_to_str(o_font0), " 0 obj\n<< /Type /Font /Subtype /Type0 /BaseFont /ReportFont /Encoding /Identity-H /DescendantFonts ["), int_to_str(o_cid)), concat(" 0 R] /ToUnicode ", concat(int_to_str(o_touni), " 0 R >>\nendobj\n")))))

    vec_push(offs, bytes_len(pdfb))
    let mut cid = buf_from(int_to_str(o_cid))
    cid = buf_push(cid, " 0 obj\n<< /Type /Font /Subtype /CIDFontType2 /BaseFont /ReportFont /CIDSystemInfo << /Registry (Adobe) /Ordering (Identity) /Supplement 0 >> /FontDescriptor ")
    cid = buf_push_i64(cid, o_desc)
    cid = buf_push(cid, " 0 R /CIDToGIDMap /Identity /DW 500")
    cid = buf_push(cid, pdf_w_array(font))
    cid = buf_push(cid, " >>\nendobj\n")
    pdfb = bytes_concat(pdfb, bytes_of_str(buf_str(cid)))

    vec_push(offs, bytes_len(pdfb))
    pdfb = bytes_concat(pdfb, bytes_of_str(concat(concat(int_to_str(o_desc), " 0 obj\n<< /Type /FontDescriptor /FontName /ReportFont /Flags 32 /FontBBox [-100 -200 1000 900] /ItalicAngle 0 /Ascent 800 /Descent -200 /CapHeight 700 /StemV 80 /FontFile2 "), concat(int_to_str(o_ffile), " 0 R >>\nendobj\n"))))

    vec_push(offs, bytes_len(pdfb))
    let flen = bytes_len(font.data)
    pdfb = bytes_concat(pdfb, bytes_of_str(concat(concat(concat(int_to_str(o_ffile), " 0 obj\n<< /Length "), int_to_str(flen)), concat(" /Length1 ", concat(int_to_str(flen), " >>\nstream\n")))))
    pdfb = bytes_concat(pdfb, font.data)
    pdfb = bytes_concat(pdfb, bytes_of_str("\nendstream\nendobj\n"))

    let mut touni = pdf_touni_cmap_str(font, uni_src)
    if touni == "" {
        touni = "/CIDInit /ProcSet findresource begin\n12 dict begin\nbegincmap\n/CIDSystemInfo << /Registry (Adobe) /Ordering (UCS) /Supplement 0 >> def\n/CMapName /Adobe-Identity-UCS def\n/CMapType 2 def\n1 begincodespacerange\n<0000> <FFFF>\nendcodespacerange\nendcmap\nCMapName currentdict /CMap defineresource pop\nend\nend\n"
    }
    vec_push(offs, bytes_len(pdfb))
    pdfb = bytes_concat(pdfb, bytes_of_str(concat(concat(concat(int_to_str(o_touni), " 0 obj\n<< /Length "), int_to_str(len(touni))), concat(" >>\nstream\n", concat(touni, "\nendstream\nendobj\n")))))

    let xref_pos = bytes_len(pdfb)
    let nobj = o_touni
    let mut xref = buf_from("xref\n0 ")
    xref = buf_push_i64(xref, nobj + 1)
    xref = buf_push(xref, "\n0000000000 65535 f \n")
    i = 1
    while i <= nobj {
        xref = buf_push(xref, pdf_pad10(vec_get(offs, i)))
        xref = buf_push(xref, " 00000 n \n")
        i = i + 1
    }
    pdfb = bytes_concat(pdfb, bytes_of_str(buf_str(xref)))
    let mut tr = buf_from("trailer\n<< /Size ")
    tr = buf_push_i64(tr, nobj + 1)
    tr = buf_push(tr, " /Root 1 0 R >>\nstartxref\n")
    tr = buf_push_i64(tr, xref_pos)
    tr = buf_push(tr, "\n%%EOF\n")
    pdfb = bytes_concat(pdfb, bytes_of_str(buf_str(tr)))
    return pdf_ok(pdfb)
}

fn pdf_default_font_path() -> str {
    return "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
}

fn pdf_load_font(font_path: str) -> TtfFont !IO {
    if font_path == "" || file_exists(font_path)? == 0 {
        let mut em = buf_from("pdf: cannot read font ")
        em = buf_push(em, font_path)
        return ttf_fail(buf_str(em))
    }
    let fb = read_file_bytes(font_path)?
    if bytes_len(fb) < 100 {
        let mut em = buf_from("pdf: cannot read font ")
        em = buf_push(em, font_path)
        return ttf_fail(buf_str(em))
    }
    return ttf_open_bytes(fb)
}

fn pdf_from_table_file(font_path: str, title: str, rows: Vec<str>) -> PdfResult !IO {
    return pdf_from_table_file_meta(font_path, title, "", rows)?
}

fn pdf_from_table_file_meta(font_path: str, title: str, meta: str, rows: Vec<str>) -> PdfResult !IO {
    let font = pdf_load_font(font_path)?
    if font.ok == 0 {
        return pdf_fail(font.err)
    }
    return pdf_from_table_full(font, title, meta, rows, 0)
}

fn pdf_wrap_words(s: str, maxc: i64) -> Vec<str> {
    let out: Vec<str> = vec_new()
    if s == "" {
        return out
    }
    let words = str_split(s, " ")
    let mut cur = ""
    let mut i: i64 = 0
    while i < vec_len(words) {
        let w = vec_get(words, i)
        if cur == "" {
            cur = w
        } else {
            let trial = concat(cur, concat(" ", w))
            if pdf_ulen(trial) > maxc {
                vec_push(out, cur)
                cur = w
            } else {
                cur = trial
            }
        }
        i = i + 1
    }
    if cur != "" {
        vec_push(out, cur)
    }
    return out
}

fn pdf_draw_line(cbuf: StrBuf, font: TtfFont, fs: i64, x: i64, y: i64, s: str) -> StrBuf {
    let mut b = cbuf
    b = buf_push(b, "BT /F1 ")
    b = buf_push(b, int_to_str(fs))
    b = buf_push(b, " Tf 1 0 0 1 ")
    b = buf_push(b, int_to_str(x))
    b = buf_push(b, " ")
    b = buf_push(b, int_to_str(y))
    b = buf_push(b, " Tm ")
    b = buf_push(b, pdf_text_hex(font, s))
    b = buf_push(b, " Tj ET\n")
    return b
}

fn pdf_tsv_rows(tsv: str) -> Vec<str> {
    let raw = str_split(tsv, "\n")
    let rows: Vec<str> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(raw) {
        let line = vec_get(raw, i)
        if i == vec_len(raw) - 1 && line == "" {
            i = i + 1
        } else {
            vec_push(rows, line)
            i = i + 1
        }
    }
    return rows
}

fn pdf_from_blocks(font: TtfFont, kinds: Vec<i64>, texts: Vec<str>) -> PdfResult {
    if font.ok == 0 {
        return pdf_fail(font.err)
    }
    if vec_len(kinds) < 1 {
        return pdf_fail("pdf: no blocks")
    }
    let page_w: i64 = 595
    let page_h: i64 = 842
    let margin: i64 = 40
    let fs: i64 = 9
    let line_h = fs + 5
    let usable_w = page_w - 2 * margin
    let page_streams: Vec<str> = vec_new()
    let mut cbuf = buf_new()
    let mut y = page_h - margin
    let n = vec_len(kinds)
    let mut bi: i64 = 0
    while bi < n {
        let kind = vec_get(kinds, bi)
        let text = vec_get(texts, bi)
        if kind == 1 {
            if y < margin + line_h * 3 {
                vec_push(page_streams, buf_str(cbuf))
                cbuf = buf_new()
                y = page_h - margin
            }
            cbuf = pdf_draw_line(cbuf, font, fs + 5, margin, y, pdf_uclip(text, 70))
            y = y - (line_h + 8)
        }
        if kind == 2 {
            let lines = pdf_wrap_to_width(font, text, fs, usable_w)
            let need = vec_len(lines) * line_h
            if y - need < margin {
                vec_push(page_streams, buf_str(cbuf))
                cbuf = buf_new()
                y = page_h - margin
            }
            let mut li: i64 = 0
            while li < vec_len(lines) {
                cbuf = pdf_draw_line(cbuf, font, fs, margin, y, vec_get(lines, li))
                y = y - line_h
                li = li + 1
            }
            y = y - 2
        }
        if kind == 3 {
            let rows = pdf_tsv_rows(text)
            if vec_len(rows) > 0 {
                let header = vec_get(rows, 0)
                let hcells = str_split(header, "\t")
                let ncols = vec_len(hcells)
                if ncols > 0 {
                    let mut tfs = fs
                    if ncols >= 6 {
                        tfs = 8
                    }
                    let tline = tfs + 4
                    if y < margin + tline * 4 {
                        vec_push(page_streams, buf_str(cbuf))
                        cbuf = buf_new()
                        y = page_h - margin
                    }
                    let widths = pdf_table_widths(font, rows, ncols, usable_w, tfs)
                    let xs: Vec<i64> = vec_new()
                    let mut acc = margin
                    let mut ci: i64 = 0
                    while ci < ncols {
                        vec_push(xs, acc)
                        acc = acc + vec_get(widths, ci)
                        ci = ci + 1
                    }
                    let mut r: i64 = 0
                    let nrows = vec_len(rows)
                    while r < nrows {
                        let line = vec_get(rows, r)
                        let cells = str_split(line, "\t")
                        let mut max_lines: i64 = 1
                        let mut c: i64 = 0
                        while c < ncols {
                            let mut cell = ""
                            if c < vec_len(cells) {
                                cell = vec_get(cells, c)
                            }
                            let mut inner = vec_get(widths, c) - 8
                            if inner < 12 {
                                inner = 12
                            }
                            let ls = pdf_wrap_to_width(font, cell, tfs, inner)
                            if vec_len(ls) > max_lines {
                                max_lines = vec_len(ls)
                            }
                            c = c + 1
                        }
                        if max_lines > 6 {
                            max_lines = 6
                        }
                        let needed_h = max_lines * tline + 4
                        if y - needed_h < margin {
                            vec_push(page_streams, buf_str(cbuf))
                            cbuf = buf_new()
                            y = page_h - margin
                        }
                        let row_top = y
                        let row_bot = y - needed_h
                        let mut fill: i64 = 0
                        if r == 0 {
                            fill = 1
                        }
                        c = 0
                        while c < ncols {
                            let cw = vec_get(widths, c)
                            cbuf = pdf_rect(cbuf, vec_get(xs, c), row_bot, cw, needed_h, fill)
                            c = c + 1
                        }
                        c = 0
                        while c < ncols {
                            let mut cell = ""
                            if c < vec_len(cells) {
                                cell = vec_get(cells, c)
                            }
                            let cw = vec_get(widths, c)
                            let mut inner = cw - 8
                            if inner < 12 {
                                inner = 12
                            }
                            let ls = pdf_wrap_to_width(font, cell, tfs, inner)
                            let mut li: i64 = 0
                            while li < vec_len(ls) && li < max_lines {
                                let show = vec_get(ls, li)
                                let mut x = vec_get(xs, c) + 4
                                if r > 0 && pdf_looks_num(cell) == 1 && vec_len(ls) == 1 {
                                    let tw = pdf_str_w(font, show, tfs)
                                    let rx = vec_get(xs, c) + cw - 4 - tw
                                    if rx > x {
                                        x = rx
                                    }
                                }
                                let ty = row_top - tfs - 2 - li * tline
                                cbuf = pdf_draw_line(cbuf, font, tfs, x, ty, show)
                                li = li + 1
                            }
                            c = c + 1
                        }
                        y = row_bot
                        r = r + 1
                    }
                    y = y - 10
                }
            }
        }
        bi = bi + 1
    }
    if buf_len(cbuf) > 0 {
        vec_push(page_streams, buf_str(cbuf))
    }
    return pdf_pack_pages_uni(font, page_streams, texts)
}

fn pdf_from_blocks_file(font_path: str, kinds: Vec<i64>, texts: Vec<str>) -> PdfResult !IO {
    let font = pdf_load_font(font_path)?
    if font.ok == 0 {
        return pdf_fail(font.err)
    }
    return pdf_from_blocks(font, kinds, texts)
}

fn pdf_from_table_default(title: str, rows: Vec<str>) -> PdfResult !IO {
    return pdf_from_table_file(pdf_default_font_path(), title, rows)?
}
